# OpenPortfo backend — example env (NO secrets). Copy to .env locally.
# Unit tests: leave defaults (fake + memory) — do not set USE_AWS_ADAPTERS.

# --- Core ---
APP_NAME=OpenPortfo
APP_ENV=local
AUTH_MODE=fake
AWS_REGION=us-east-1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5173

# --- Adapter selection ---
# memory = in-process fakes (default; unit tests)
# aws = DynamoDB + S3 adapters
STORAGE_BACKEND=memory
USE_AWS_ADAPTERS=false

# --- LocalStack (docker compose up -d from repo root) ---
# See infra/localstack/README.md
# STORAGE_BACKEND=aws
# USE_AWS_ADAPTERS=true
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# DYNAMODB_ENDPOINT_URL=http://localhost:4566
# S3_ENDPOINT_URL=http://localhost:4566
# DATA_BUCKET=openportfo-data-local

# --- Cognito (AUTH_MODE=cognito) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- DynamoDB table names (defaults match infra/cloudformation.yml) ---
USERS_TABLE=openportfo-users
HOLDINGS_TABLE=openportfo-holdings
WATCHLIST_TABLE=openportfo-watchlist
PRICE_CACHE_TABLE=openportfo-price-cache
NEWS_TABLE=openportfo-news
SETTINGS_TABLE=openportfo-settings
FX_TABLE=openportfo-fx
RSS_TABLE=openportfo-rss
JOB_RUNS_TABLE=openportfo-job-runs
SNAPSHOTS_TABLE=openportfo-snapshots

# --- S3 ---
DATA_BUCKET=

# --- Market / FX (never commit real keys) ---
MARKET_CLIENT_MODE=fixture
# MARKET_CLIENT_MODE=http   # live CoinGecko + vnstock; catalog is fallback only
COINGECKO_API_KEY=
EXCHANGE_RATE_API_KEY=
PRICE_CACHE_TTL_SECONDS=600

# --- LLM chatbot (server-side only; never expose keys to the browser) ---
# Swap later: LLM_PROVIDER=xai LLM_BASE_URL=https://api.x.ai/v1 XAI_API_KEY=...
LLM_PROVIDER=openrouter
LLM_BASE_URL=
LLM_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
LLM_DEFAULT_MODEL=openrouter/free
LLM_FALLBACK_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-32b:free,mistralai/mistral-small-3.1-24b-instruct:free
LLM_FREE_ONLY=true
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOOL_ROUNDS=8
LLM_MAX_TOKENS=2048
LLM_RETRY_MAX=2

# --- Prod EB / Lambda example (set in AWS console, not git) ---
# APP_ENV=prod
# AUTH_MODE=cognito
# STORAGE_BACKEND=aws
# USE_AWS_ADAPTERS=true
# DATA_BUCKET=openportfo-data-xxxxx
# COGNITO_USER_POOL_ID=us-east-1_XXXX
# COGNITO_APP_CLIENT_ID=xxxxxxxx
